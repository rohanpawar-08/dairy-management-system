{
  "name": "dairy-management-system",
  "version": "0.1.0",
  "description": "Offline-First Windows Desktop Application for Milk Collection Centres in Maharashtra, India",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "cross-env ELECTRON_DEV=true concurrently -k -s first \"npm run dev:renderer\" \"npm run dev:electron-wait\"",
    "dev:renderer": "ng serve --port 4200",
    "dev:electron-wait": "wait-on tcp:4200 && npm run build:electron && electron .",
    "build:renderer": "ng build --configuration production",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-migrations.js",
    "build": "npm run build:renderer && npm run build:electron",
    "rebuild": "node scripts/rebuild-native.js",
    "test": "node scripts/run-all-tests.js",
    "test:watch": "vitest",
    "test:db": "vitest run tests/integration/db.spec.ts",
    "test:backup-basic": "vitest run tests/integration/backup.spec.ts",
    "test:auth": "vitest run tests/unit/credentials.spec.ts tests/integration/auth.spec.ts",
    "test:audit-base": "vitest run tests/integration/audit.spec.ts",
    "test:farmers": "node scripts/run-farmers-tests.js",
    "test:rates": "node scripts/run-rates-tests.js",
    "test:collection": "node scripts/run-collection-tests.js",
    "test:ledger": "node scripts/run-ledger-tests.js",
    "test:settlements": "node scripts/run-settlement-tests.js",
    "test:reports": "vitest run tests/integration/reports.spec.ts tests/unit/pdf-export.spec.ts tests/unit/report-template.spec.ts && ng test --include src/app/core/services/report-state.service.spec.ts --include src/app/features/reports/reports.component.spec.ts --watch=false",
    "test:ipc-smoke": "npm run build && node scripts/run-ipc-smoke.js",
    "build:smoke-pack": "npm run build && node scripts/run-smoke-pack.js",
    "pack:dir": "electron-builder --dir --config electron-builder.yml --publish never",
    "postinstall": "node scripts/ensure-electron-binary.js"
  },
  "dependencies": {
    "@angular/animations": "22.0.0",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/router": "22.0.0",
    "better-sqlite3": "13.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.13.10",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "35.0.0",
    "electron-builder": "26.1.0",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "4.0.8",
    "wait-on": "8.0.4"
  }
}
